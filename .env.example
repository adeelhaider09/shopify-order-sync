DATABASE_URL=postgres://postgres:postgres@localhost:5432/order_sync
# The app's client secret from the Shopify Partner dashboard (used to verify webhook HMACs)
SHOPIFY_WEBHOOK_SECRET=replace-me
# Bearer token for the read API (16+ chars)
API_TOKEN=replace-with-a-long-random-string
PORT=3000
WORKER_BATCH_SIZE=25
WORKER_POLL_MS=1000
WORKER_MAX_ATTEMPTS=8
